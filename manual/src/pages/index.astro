---
import Shell from '../layouts/Shell.astro';
import { getNotes, getManual, titleOf } from '../lib';
import preamble from '../../content/manual/preamble.json';
const manual = await getManual();
const guides = (await getNotes()).filter(n => !n.data.order);
const links = [
  { title: 'The Cook Standard', href: '/standard/', blurb: 'The formal specification. Where the manual and the Standard disagree, the Standard wins.' },
  { title: 'Modules', href: 'https://rocks.usecook.com', blurb: 'cook_cc, cook_pnpm, cook_dotnet, cook_rust: the blessed index.' },
  { title: 'LioraLabs/cook', href: 'https://github.com/LioraLabs/cook', blurb: 'Source, examples, and the manual this site is built from.' },
  { title: 'usecook.com', href: 'https://usecook.com', blurb: 'Cook Cloud, Modules Pro, and build pipeline consulting.' },
];
---
<Shell>
  <div class="page-heading"><h1>The Cook Manual</h1><p set:html={preamble.lede.replace(/\n/g, ' ')} /></div>
  <div class="tiles">
    <a class="tile w2 h2 accent" style="--k:0" href={`/n/${manual[0].id}`}>
      <span class="kicker">Start here</span>
      <h2>Read it top to bottom</h2>
      <p>{manual.length} chapters, every Cookfile snippet real v1.0 syntax. About an hour.</p>
    </a>
    {manual.map((n, i) => (
      <a class="tile w2" style={`--k:${i + 1}`} href={`/n/${n.id}`}>
        <span class="kicker">Chapter {n.data.order}</span>
        <h2>{titleOf(n).replace(/^\d+\. /, '')}</h2>
        <p>{n.data.summary}</p>
      </a>
    ))}
    {guides.map((n, i) => (
      <a class="tile w2" style={`--k:${manual.length + i + 1}`} href={`/n/${n.id}`}>
        <span class="kicker">Guide{n.data.slides && ' · slides'}</span>
        <h2>{titleOf(n)}</h2>
        {n.data.summary && <p>{n.data.summary}</p>}
      </a>
    ))}
    {links.map((l, i) => (
      <a class="tile w3" style={`--k:${manual.length + guides.length + i + 1}`} href={l.href}>
        <span class="kicker">{l.href.startsWith('http') ? new URL(l.href).host : 'docs.usecook.com' + l.href}</span>
        <h2>{l.title}</h2>
        <p>{l.blurb}</p>
      </a>
    ))}
  </div>
</Shell>
