{
  "name": "cook", "scopeName": "source.cook", "fileTypes": ["Cookfile"],
  "patterns": [
    { "name": "comment.line.number-sign.cook", "match": "#.*$" },
    { "name": "string.quoted.double.cook", "begin": "\"", "end": "\"", "patterns": [{ "name": "variable.other.placeholder.cook", "match": "\\$<[^>]*>" }] },
    { "name": "variable.other.placeholder.cook", "match": "\\$<[^>]*>" },
    { "name": "keyword.control.cook", "match": "^\\s*(recipe|chore|probe|files|tools|use|test|config|import|register|gather|cook|seal|local|pinned|nondet|materialize|json|string|env)\\b" },
    { "name": "keyword.other.lua.cook", "match": "\\b(local|function|end|return|if|then|else|for|in|do|while)\\b" },
    { "name": "entity.name.function.cook", "match": "(?<=^(?:recipe|chore|probe|files|tools|test)\\s+)[A-Za-z0-9_:.-]+" },
    { "name": "constant.numeric.cook", "match": "\\b\\d+\\b" },
    { "name": "keyword.operator.cook", "match": "@[A-Za-z0-9_]+|>>|>\\{|\\{|\\}|=" }
  ]
}
