{
  "name": "cook-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/manual.mjs",
    "dev": "astro dev --host 127.0.0.1 --port 4400",
    "prebuild": "node scripts/manual.mjs",
    "build": "astro build && npm run standard",
    "preview": "astro preview",
    "test": "node scripts/check.mjs",
    "deploy": "npm run build && wrangler deploy",
    "standard": "cd ../standard && pnpm build && rm -rf ../manual/dist/standard && cp -r dist ../manual/dist/standard"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "astro": "^7.3.3",
    "astro-expressive-code": "^0.44.2",
    "astro-mermaid": "^2.1.0",
    "katex": "^0.16.45",
    "medium-zoom": "^1.1.0",
    "mermaid": "^11.17.2",
    "minisearch": "^7.2.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-callouts": "^2.2.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "three": "^0.186.1"
  }
}
