use checks

chore build
    pnpm build

recipe lint
    checks.lint_keywords()

# The renderer's own suite: the remark/rehype plugins that turn clause markers
# into anchors, resolve `§{...}` xrefs, and lint bare refs, plus the slug
# registries they consult.
#
# It ran only under `pnpm test`, which nothing invoked, so a failure could sit
# in the tree indefinitely — and one did. `slug-renames-consistency` had been
# red against five renames whose replacements were real and anchored all along;
# it was checking them against the v0.10 positional table rather than against
# the anchors the chapters define. A suite outside the fan-out grades nothing.
#
# The chapters are inputs, not just the plugin sources: the consistency check
# harvests `[#slug]` anchors from the .mdx files themselves, so retitling a
# section re-runs this.
#
# Declared as ingredients rather than sealed on a `files` probe, which is the
# shape `ts.test` uses and `ts.rust` does not. The body names no $<in>, so this
# stays a single unit either way; the difference is that a seal-only test unit
# re-runs every build, and this one has 58 tests and a node start-up to amortise.
probe vitest:tools
    tools { node pnpm }

recipe vitest
    ingredients "src/plugins/**/*.ts" "scripts/*.ts"
        "src/content/docs/**/*.mdx"
        "package.json" "pnpm-lock.yaml" "vitest.config.ts"
    seal vitest:tools
    test { pnpm vitest run }

chore host
    pnpm host

# Long-running: builds the docs, then serves them until Ctrl-C.
chore preview
    pnpm build
    pnpm host

# Checks cook-lang against the corpus as it stood at a published tag rather than
# as it stands here. Imperative by nature — it reconstructs a tree from git
# history — so it stays a chore; what moved out of Lua is the shell pipeline,
# which is now a script a shell can run directly rather than a string built with
# table.concat and handed to cook.exec.
chore against-tag version=(fs.read("VERSION"):gsub("%s+$", ""))
    scripts/against-tag.sh $<version>
