config
    var.NVIM_SITE = var.NVIM_SITE or (host.env("HOME", "") .. "/.local/share/nvim/site")

# One run produces all three outputs. src/tree_sitter/*.h tracks the CLI
# version rather than grammar.js, so it stays undeclared.
recipe generate
    ingredients "grammar.js"
    cook "src/parser.c" "src/node-types.json" "src/grammar.json" {
        tree-sitter generate
    }

recipe test
    ingredients "test/corpus/*.txt"
    test { : $<generate> && tree-sitter test }

# The harness walks the Standard's corpus, which lives outside this member, so
# it cannot be an ingredient (a `../` pattern escapes the member root) and the
# script alone was the whole declared input set. That is how CS-0172 turned the
# tree green while adding three fixtures this grammar rejects: the corpus grew,
# the key did not move, and the unit replayed a cached pass until v0.10.1 was
# tagged off it. A `files` probe is the sealable form of a determinant that is
# not the driver (§22.5.2) — the script drives, the corpus determines.
probe conformance:corpus
    files { "//standard/conformance/**" }

recipe conformance
    ingredients "scripts/conformance.mjs"
    seal conformance:corpus
    test { : $<generate> && node scripts/conformance.mjs }

# The rendered Standard bundles the wasm parser for in-browser highlighting.
recipe wasm: generate
    ingredients "grammar.js" "src/parser.c" "src/scanner.c"
    cook "../standard/public/tree-sitter-cook.wasm" {
        mkdir -p ../standard/public && tree-sitter build --wasm . -o $<out>
    }

recipe nvim-parser: generate
    ingredients "src/parser.c" "src/scanner.c"
    cook "build/parser/cook.so" {
        mkdir -p build/parser
        tree-sitter build . -o $<out>
    }

# The Rust binding compiles the generated parser. Sealed rather than declared
# as ingredients because nothing here consumes $<in>.
probe rust:tools
    tools { cargo cc }

probe rust:files
    files { "bindings/rust/*.rs" "src/*.c" "src/tree_sitter/*.h" "src/node-types.json" "queries/*.scm" "Cargo.toml" "Cargo.lock" }

recipe rust: generate
    seal rust:tools rust:files
    test { cargo test --manifest-path Cargo.toml }

# src/ is generated but tracked. Sourceless on purpose: it asserts a property
# of the working tree, so a cache hit could hide real drift.
recipe check-generated
    test { tree-sitter generate; git diff --exit-code -- src/ || (echo "src/ is stale — run 'cook ts.generate' and commit the result" >&2; exit 1) }

chore nvim-install: nvim-parser
    mkdir -p $NVIM_SITE/parser
    cp $<nvim-parser> $NVIM_SITE/parser/cook.so
    echo "installed parser → $NVIM_SITE/parser/cook.so"
    bash scripts/clean-stale-nvim-parsers.sh
    bash scripts/install-nvim-queries.sh
