config
    var.NVIM_SITE = var.NVIM_SITE or (host.env("HOME", "") .. "/.local/share/nvim/site")

# src/ is generated but tracked, so the CLI that generates it is part of the
# source: 0.25.10, 0.26.9 and 0.26.11 each emit different bytes for the same
# grammar.js (bd4fe6b0), and src/tree_sitter/*.h tracks the CLI rather than the
# grammar. package.json pins the version and ci.yml installs it, but until
# CS-0181 the determinant could not be named — `tools` took the narrow IDENT and
# `tree-sitter` has a hyphen. So a developer whose PATH resolved a different CLI
# regenerated tracked files in place with no key moving to say why.
probe generate:tool
    tools { tree-sitter }

# The determinant above says WHICH CLI ran; it cannot say which one SHOULD.
# That gap is the whole bug: with a different CLI on PATH the key moved
# correctly, `generate` re-ran correctly, and the correct behaviour was to
# overwrite tracked src/ with the wrong CLI's bytes. `check-generated` then
# reported drift it had not caused, and the dirty tree outlived the run to
# surface later as an unexplained `cook release` failure (COOK-356 closed that
# hole in check-generated.sh and left it open in the recipe whose job is to
# write). An observation cannot be a constraint; this is the constraint.
#
# Sourceless on purpose, for the same reason `check-generated` is: it asserts a
# property of the developer's environment rather than of the tracked tree, and
# a cache hit would replay a pass recorded under a CLI that is no longer the
# one on PATH — hiding exactly what it exists to catch. Every recipe that
# invokes the CLI depends on it, so a mismatch BLOCKS them (§8.6, CS-0177)
# instead of advising against them, and nothing is written.
recipe ts-cli-pinned
    test { scripts/check-ts-cli.sh }

# One run produces all six. The three headers were undeclared for as long as the
# CLI was: they track the CLI rather than grammar.js, so declaring them under a
# key that could not see the CLI would have made a cache hit restore three files
# the CLI had just written differently. With `generate:tool` sealed the key does
# see it, so they are declared — and a restore now covers everything
# `tree-sitter generate` writes, which is what `check-generated` diffs.
recipe generate: ts-cli-pinned
    ingredients "grammar.js"
    seal generate:tool
    cook "src/parser.c" "src/node-types.json" "src/grammar.json"
        "src/tree_sitter/alloc.h" "src/tree_sitter/array.h" "src/tree_sitter/parser.h" {
        tree-sitter generate
    }

recipe test: ts-cli-pinned
    ingredients "test/corpus/*.txt"
    seal generate:tool
    test { : $<generate> && tree-sitter test }

# One unit per fixture, fanned out over the Standard's corpus (CS-0182). The
# body references $<in>, which puts the step in one-to-one mode (§8.6.1), and
# each unit keys on its own fixture alone — so editing one fixture re-runs one
# unit and the other 283 stay cached. The `//` prefix anchors the glob at the
# workspace root, which is what lets a member reach a sibling member's tree; a
# bare `../` pattern would escape the member root and is rejected.
#
# This replaces a single unit sealed on a `files` probe over the whole corpus.
# That shape was correct but coarse: any fixture edit re-graded all 284. It was
# also the shape CS-0172 caught being *too* coarse in the other direction —
# before the seal existed the script alone was the declared input set, the
# corpus grew, the key did not move, and the unit replayed a cached pass until
# v0.10.1 was tagged off it. Per-fixture keys retire both failure modes: nothing
# is under-declared, and nothing re-runs that did not change.
recipe conformance: parser-lib
    ingredients "//standard/conformance/positive/*/Cookfile"
        "//standard/conformance/negative/*/Cookfile"
    test { node scripts/conformance.mjs --case $<in> }

# The whole corpus in one process. Same harness, no fan-out: this is the form
# CI and a human want when the question is "is the grammar green", where 284
# process spawns buy nothing. Sourceless on purpose — it is a convenience view
# over work `conformance` already caches per fixture, so caching it too would
# only add a second, coarser key to invalidate.
chore conformance-all: parser-lib
    node scripts/conformance.mjs

# The rendered Standard bundles the wasm parser for in-browser highlighting.
recipe wasm: generate ts-cli-pinned
    ingredients "grammar.js" "src/scanner.c"
    seal generate:tool
    cook "../standard/public/tree-sitter-cook.wasm" {
        mkdir -p ../standard/public
        : $<generate>
        tree-sitter build --wasm . -o $<out>
    }

# Named `parser-lib` rather than `nvim-parser` because it has two consumers now:
# the nvim install chore below, and every `conformance` fan-out unit, which
# grades its fixture against this artifact instead of building a parser of its
# own. Declaring it once as a dependency is what keeps the fan-out affordable.
recipe parser-lib: generate ts-cli-pinned
    ingredients "src/scanner.c"
    seal generate:tool
    cook "build/parser/cook.so" {
        mkdir -p build/parser
        : $<generate>
        tree-sitter build . -o $<out>
    }

# The Rust binding compiles the generated parser. Sealed rather than declared
# as ingredients because nothing here consumes $<in>.
probe rust:tools
    tools { cargo cc }

probe rust:files
    files { "bindings/rust/*.rs" "src/*.c" "src/tree_sitter/*.h" "src/node-types.json" "queries/*.scm" "Cargo.toml" "Cargo.lock" }

recipe rust: generate
    seal rust:tools rust:files
    test { cargo test --manifest-path Cargo.toml }

# src/ is generated but tracked. Sourceless on purpose: it asserts a property
# of the working tree, so a cache hit could hide real drift.
#
# The check generates into a scratch directory and compares; it never writes to
# src/. The previous form ran `tree-sitter generate` in place and then diffed,
# which made this *test* mutate tracked source on every run — and turned a CLI
# mismatch into a self-inflicted wound, rewriting src/ with the wrong CLI's
# bytes and then correctly reporting the drift it had just caused. The dirty
# tree outlived the run and surfaced later as an unexplained `cook release`
# failure, twice (COOK-356).
recipe check-generated: ts-cli-pinned
    test { scripts/check-generated.sh }

chore nvim-install: parser-lib
    mkdir -p $NVIM_SITE/parser
    cp $<parser-lib> $NVIM_SITE/parser/cook.so
    echo "installed parser → $NVIM_SITE/parser/cook.so"
    bash scripts/clean-stale-nvim-parsers.sh
    bash scripts/install-nvim-queries.sh
