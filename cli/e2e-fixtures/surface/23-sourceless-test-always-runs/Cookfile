# A seal is enough to key a sourceless test. The chore dependency remains
# unconditional and demonstrates that chores do not acquire cache semantics.

files observed
    "probe.txt"

chore always
    printf x >> chore-runs

recipe gen
    gather "seed.txt"
    cook "build/gen.txt" { mkdir -p build && cp $<in> $<out> }

recipe assert-tree: gen always
    seal observed
    test { printf x >> test-runs && grep -q ok probe.txt }
