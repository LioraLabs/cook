# CS-0243 (COOK-527): a reached probe always observes — this one mints a
# fresh nonce on every invocation regardless of what it declares, so its own
# node is never a cache hit. `seal "seed.txt"` is what's left of this
# fixture's original point (CS-0178 keylessness, before there was a
# probe-value cache to have a key into) and stays for that reason, not
# because it changes whether `demo:nonce` re-executes.
probe demo:nonce
    seal "seed.txt"
    >{
        local stamp = cook.sh("date +%s%N"):gsub("%s+$", "")
        return { stamp = stamp }
    }

recipe build
    cook.add_unit({
        name    = "record",
        inputs  = {},
        outputs = {"build/probed.txt"},
        probes  = {"demo:nonce"},
        command = "mkdir -p build && echo $<demo:nonce.stamp> > build/probed.txt",
    })
    test { cat build/probed.txt }
